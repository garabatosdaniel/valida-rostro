# Origenes permitidos para CORS (separados por coma)
# En local: http://localhost:5173
# En produccion: https://tu-frontend.railway.app
ALLOWED_ORIGINS=http://localhost:5173

# Puerto del servidor (Railway lo inyecta automaticamente)
PORT=8000

# API key de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-tu-api-key-aqui

# Modelo de vision a usar (opcional, default: google/gemini-2.0-flash-001)
# Opciones baratas con vision: google/gemini-2.0-flash-001, google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.0-flash-001
